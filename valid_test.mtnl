[# Program: MotionLang Lexical Analyzer Test Suite
 Validates all keywords, data types, operators, and delimiters
 #]

# Basic variable declarations 
hold text name; 
grab name = prompt("Enter student name: ");

# Declaration statement variable only example
hold num age;

# Input Statement example:
grab age = prompt("Enter student age: ");

hold dec gpa = 1.25;
fixed text degree_program = "BSCS";
hold text homeCity = "Manila City";
hold text college_Year = "Sophomore"; # declaration w/ assignment ex.
hold char abcde = 'a';

# 2. Delimiters, Brackets, and Stash Arrays
hold stash num scores[3]; # declaration of data type/variable list ex.
hold flag ppl_score = 1;

# 3. Arithmetic Operations: +, -, *, /, %, div, ^
hold num sum = 10 + 5;
hold num diff = 20 - 4;
hold num score = 6 * 7;
hold dec quotient = 15.0 / 2.0;
hold num remainder = 17 % 5;
hold num int_quotient = 17 div 5;
hold num power_value = 2 ^ 3;

emit score; # Output Rule 2: Variable Only example
emit "Your score is:   ";
emit score;

# 4. Relational & Boolean Word Operators: ==, !=, <, >, <=, >=, AND, OR, NOT
# Rule 3: Nested if
if ((age >= 18) AND NOT (gpa > 3.00)) {
    emit "Status: Qualified Regular Adult Student";
}
else if ((age < 18) OR (gpa == 1.00)) {
    emit "Status: Evaluation Needed";
}
else {
    emit "Status: Standard Review"; # Output statement rule 1: String only example
}

if (sum != 0) {
    emit "The sum is not zero!";
}

if (diff <= 0) {
    emit "Negative diff!"; # Condition If
}

# Rule 2: If-else
if (score >= 75) {
    emit "Passed!";
} 
else {
    emit "Repeat";
}

# 5. Loop Keywords: spin, halt, skip (formal)
hold num counter = 0;
spin (counter < 10 times) {
    counter = counter + 1;

    if (counter == 2) {
        skip;
    }

    if (counter == 8) {
        halt;
    }
}

# 6. Function Keywords: routine, return
routine compute_bonus(num base_val, dec multiplier) {
    hold dec adjusted_val = base_val * multiplier;
    return adjusted_val;
}

# Plain Assignment Statements Verification
gpa = 1.25;
adjusted_val = base_val;
counter = counter + 1;

# 7. Free-Field Format Verification
hold   num    spaced_val   =
    100   +
    200   ;