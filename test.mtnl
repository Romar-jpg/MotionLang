hold text name; 
grab name = prompt("What is your name?: "); 

hold num age; 
grab age = prompt("How old are you?: " ); 

hold dec gpa = 1.25; 

# Check user age bracket 

if (age >= 18) {
    emit "You are an adult"
}
else if (age >= 13) {
    emit "You are a teenager"
}
else {
    emit "You are a child"
}

# Check if user's grade is passed or failed 

if (gpa <= 3.00) {
    emit "You have a PASSING grade!"
}
else {
    emit "You have a FAILED grade!"
}