# MotionLang Lexical Analyzer - Comprehensive Error Suite
# Triggers lexical error traps across identifier rules, numeric
# formats, string/char bounds, and unauthorized symbol sets.

#Must start lowercase, cannot start with uppercase or underscore.❌
hold num UserScore = 100; 

# 1. Invalid Identifier Constraints ❌
# cannot start with underscore 
hold num _counter = 0;

# Identifiers cannot contain digits anywhere.❌
hold dec box1 = 15.5;

# Rule: Identifiers cannot put unauthorized symbols or hyphens.❌
hold text total@count = "5000000";
hold text total-count = "hyphenated";

# Rule: Whitespace cannot split an identifier.❌
hold num box score = 50;

# no trailing decimal digits❌
hold dec avg_score = 45.; 

# 2. Unauthorized Symbols & Foreign Characters✅
# Traps characters outside the MotionLang operational and delimiter alphabet.
hold text money = 500$;
hold num bit_flag = 10 & 20;
hold num score = 100 \ 2;

# 3. Malformed Numeric & Decimal Literals
# Multiple consecutive decimal points 
hold dec broken_decimal = 12.34.56;

# 4. Unterminated Literals & Boundary Violations✅
hold text open_string = "She is my black pearl;

# Empty character❌
hold char no_char = '';

# Multi-character literal inside single quotes❌
hold char multi_char = 'abc';

# Unterminated character using single quote✅
hold char open_char = 'x;

# Unterminated char using double quote (NEW)

# Unauthorized symbols within integers❌
hold num error_num = 123a45; 

# 5. Malformed Operator Sequences❌
# Invalid compound assignment / relational sequences
hold num false_logic = 10 === 5; (first two is detected as relational_equal, then third one is assignment equal)
hold num bad_not = 10 ! 2; (detected as separates)

