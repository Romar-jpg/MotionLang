[# MotionLang Syntax & Lexical Analyzer - Comprehensive Error Suite
   Tests grammatical violations across all statement types and verifies
   panic-mode error recovery with line/column diagnostics. #]

# 1. MISSING SEMICOLONS & STATEMENT TERMINATORS + outside chars
hold num age = 20

hold text total@count = "fifty";

# 2. DECLARATION & ARRAY SYNTAX ERRORS
# Array declaration missing size inside brackets
hold num scored[];

# Missing data type in declaration
hold missing_type = 10;

# 3. MALFORMED EXPRESSIONS & OPERATOR SEQUENCES
# Whitespace splitting an identifier (unexpected 'score' after 'box')
hold num box score = 50;

# Consecutive binary operators and bad number
hold num bad_math = 10 + * 5;
hold num bad_nums = 12.34.56;

# Invalid compound operator sequences
hold num false_logic = 10 === 5;
hold num bad_not = 10 ! 2;

# Unclosed parenthesis in expression
hold num unclosed_paren = (5 + 3;

# 4. INPUT (grab) & OUTPUT (emit) SYNTAX ERRORS
# 'grab' requires prompt("...") on the right-hand side
grab age = 25;

# 'emit' missing expression before semicolon
emit ;

# 5. CONDITIONAL (if / else if / else) ERRORS
# Missing parentheses around condition
if age >= 18 {
    emit "Missing parens";
}

# Orphan 'else' with no preceding 'if'
else {
    emit "Orphan else";
}

# 6. LOOP (spin) & FLOW CONTROL (halt / skip / return) ERRORS
# Wrong noise word ('do' instead of 'times')
spin (age < 25 do) {
    skip
    halt
}

# Empty loop header
spin () {
    emit "Empty spin";
}

# 8. LEXICAL ERROR TOKENS
hold num _counter = 0;
hold dec box1 = 15.5;
hold dec avg_score = 45.;
hold text money = 500$;
hold num error_num = 123a45;

# 4. Unterminated Literals & Boundary Violations
hold text open_string = "She is my black pearl;

# Empty character
hold char no_char = '';

# Multi-character literal inside single quotes
hold char multi_char = 'abc';

# Unterminated character using single quote
hold char open_char = 'x;